module passive_top_tb ();


localparam number_of_tests = 1;
localparam int M = 96;
localparam int N = 64;
localparam int WIDTH = 32;
localparam int THRESHOLD = 1;

bit clk , rst_n;
logic  signed [WIDTH -1:0] Z [N];
logic signed [WIDTH -1:0] x [N];


logic signed [WIDTH-1:0] Z_in [number_of_tests][N];
logic signed [WIDTH-1:0] x_ref [number_of_tests][N];

int passed , failed;

passive_top #(.M(M),.N(N),.WIDTH(WIDTH),.THRESHOLD(THRESHOLD)) PASSIVE_ALG (.*);

always begin
    #5 clk = ~clk;
end

task automatic load_data(
    ref var logic signed [WIDTH - 1: 0] data_arr [number_of_tests][N],
    input int fid
);
    int i = 0; // Iterating over the tests
    int j = 0; // iterating over the elements of same test
    while($fscanf(fid,"%d\n",data_arr[i][j])==1) begin
        if((++j)==N) begin
            i++;
            j = 0;
        end
    end
    
endtask


initial begin
    automatic int fid1 = $fopen("../MATLAB/MATLAB Vars/Z.txt","r");
    automatic int fid2 = $fopen("../MATLAB/MATLAB Vars/x_final.txt","r");
    
    if(!(fid1&&fid2)) begin
        $display("Can't open the text files\n");
        $stop;
    end

    rst_n = 0;
    repeat(3) @(negedge clk);
    rst_n = 1;

    load_data(.data_arr(Z_in),.fid(fid1));
    load_data(.data_arr(x_ref),.fid(fid2));

    for ( int i = 0 ; i < number_of_tests ; i++ ) begin
        Z = Z_in[i];
        repeat(100) @(negedge clk);
        if(x_ref[i] === x) begin
            passed++;
        end
        else begin
            failed++;
            $display("Expected = %p \n\n Found = %p",x_ref[i],x);
        end
    end


    $stop;

end

endmodule